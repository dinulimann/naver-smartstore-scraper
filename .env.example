# Server
PORT=3000

# Comma-separated list of proxies, each as host:port:username:password
# (username:password may be omitted for unauthenticated proxies -> host:port)
# Add as many as you have — more proxies = better IP rotation and higher
# sustainable request volume. A single trial proxy will rate-limit quickly
# under real load (1000+ requests/hour).
#
# Can be left EMPTY for a direct connection (no proxy) — not just a
# fallback. A residential/mobile IP with no proxy-pool history (e.g. a
# phone's mobile-carrier hotspot) reached the product page reliably where
# every exhausted commercial proxy pool tested during this investigation
# didn't (see README hypothesis row 45).
PROXIES=proxy.example.com:9999:username:password

# Throttling: random delay (ms) inserted before each navigation
MIN_DELAY_MS=1500
MAX_DELAY_MS=4500

# Max concurrent browser sessions
CONCURRENCY=3

# Per-request navigation timeout (ms). 30s isn't a round-number guess —
# instrumented logging observed Naver's own block/challenge response
# arriving at ~20.3s on a slow path; a 20s timeout was clipping that real
# response and misreporting it as a client-side timeout. See README.
NAV_TIMEOUT_MS=30000

# Retries per product before giving up
MAX_RETRIES=3

# In-memory response cache TTL (ms) — avoids re-scraping the same product
# repeatedly during bursts/tests
CACHE_TTL_MS=60000

# Set to "false" to run a visible browser window while debugging locally
HEADLESS=true

# Launch the system's real installed Chrome instead of Patchright's bundled
# Chromium. Measured to produce a JA4 TLS fingerprint identical to genuine
# human Chrome (bundled Chromium's differs slightly). Requires Chrome to
# actually be installed on this host — leave "false" on servers/containers
# that only have the bundled Chromium available.
USE_SYSTEM_CHROME=false

# --- Optional: ScrapingBee backend ---
# If SCRAPINGBEE_API_KEY is set, the API uses ScrapingBee's rendering/proxy
# service instead of the local Puppeteer+PROXIES pipeline above. Useful when
# you don't have working residential/mobile proxies of your own yet — get a
# free trial key at https://www.scrapingbee.com (no credit card required).
# When this is set, PROXIES above is ignored.
SCRAPINGBEE_API_KEY=
SCRAPINGBEE_COUNTRY=kr

# --- Optional: product discovery script (scripts/discover-products.ts) ---
# Free Naver Search API credentials, used only to build a seed list of
# currently-active SmartStore product URLs for testing (register a Search
# API app at https://developers.naver.com/apps). Not used by the server
# itself.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Optional: CAPTCHA solving ---
# When Naver serves its CAPTCHA challenge (a small receipt-style image with
# a fill-in-the-blank question about text printed on it — see README
# hypothesis rows 36-38), attempt to solve it via OCR instead of just
# failing. Requires Tesseract installed on the host: `brew install
# tesseract` (macOS) or `apt install tesseract-ocr` (Debian/Ubuntu).
SOLVE_CAPTCHA=false
TESSERACT_PATH=tesseract

# Path to a Playwright storageState JSON from a real, logged-in Naver
# session. Generate one with `npm run save-naver-session`. Strongly
# recommended when SOLVE_CAPTCHA is on: every observed case of a correctly
# solved CAPTCHA reaching the actual product page happened on an
# authenticated session — the same solve on an anonymous session redirected
# to the login wall instead (see README hypothesis row 37).
NAVER_SESSION_STATE_PATH=
